{
  "name": "hbbw-profile-motion",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "remotion studio src/index.ts",
    "still:dark": "remotion still src/index.ts HeroDark ../assets/preview-dark.png --frame=60",
    "still:light": "remotion still src/index.ts HeroLight ../assets/preview-light.png --frame=60",
    "render:dark": "remotion render src/index.ts HeroDark ../assets/hero-dark.gif --scale=0.8333",
    "render:light": "remotion render src/index.ts HeroLight ../assets/hero-light.gif --scale=0.8333",
    "render": "npm run render:dark && npm run render:light"
  },
  "dependencies": {
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remotion": "4.0.537"
  },
  "devDependencies": {
    "@remotion/cli": "4.0.537",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "typescript": "5.9.3"
  }
}
